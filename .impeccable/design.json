  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "翡翠主按钮，用于「开始搭配」「保存记录」等主操作。",
      "html": "<button class=\"ds-btn-primary\">开始搭配</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;border:1px solid transparent;border-radius:12px;padding:13px 22px;background:var(--accent-fill,#0b7a55);color:var(--on-accent,#ffffff);font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",\"Segoe UI\",sans-serif;font-size:15px;font-weight:700;cursor:pointer;transition:transform .12s ease}.ds-btn-primary:hover{filter:brightness(1.06)}.ds-btn-primary:focus-visible{outline:2px solid var(--accent-fill,#0b7a55);outline-offset:2px}.ds-btn-primary:active{transform:scale(.98)}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "1px 柔线描边的次操作按钮，如「记录体重」「添加一项」。",
      "html": "<button class=\"ds-btn-ghost\">记录体重</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--line,#e6e6e2);border-radius:12px;padding:13px 22px;background:transparent;color:var(--text,#1a1a1a);font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",\"Segoe UI\",sans-serif;font-size:15px;font-weight:700;cursor:pointer;transition:transform .12s ease,border-color .12s ease}.ds-btn-ghost:hover{border-color:var(--muted,#6b6b6b)}.ds-btn-ghost:focus-visible{outline:2px solid var(--accent-fill,#0b7a55);outline-offset:2px}.ds-btn-ghost:active{transform:scale(.98)}"
    },
    {
      "name": "Hero / Page Intro",
      "kind": "custom",
      "refersTo": null,
      "description": "两页页首：落地页为单列满屏 Hero（一句主张 + 一颗主按钮，无配图）；工具页为紧凑页首（eyebrow + 一句 + 主/次按钮），随即进入目标三卡。",
      "html": "<header class=\"ds-hero\"><div class=\"ds-hero__eyebrow\">三大营养素 · 每日体重</div><h1 class=\"ds-hero__title\">吃得明白，练得出来</h1><p class=\"ds-hero__sub\">按你的体重定制蛋白质、碳水、脂肪目标。</p><a class=\"ds-hero__cta\">开始搭配</a></header>",
      "css": ".ds-hero{max-width:820px;font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",\"Segoe UI\",sans-serif;color:var(--text,#1a1a1a)}.ds-hero__eyebrow{font-size:12px;letter-spacing:.2em;color:var(--accent-text,#0b7a55);font-weight:700}.ds-hero__title{font-size:clamp(34px,5.4vw,58px);line-height:1.12;letter-spacing:-.02em;margin:14px 0 18px;text-wrap:balance}.ds-hero__sub{margin:0;color:var(--muted,#6b6b6b);font-size:17px;max-width:52ch}.ds-hero__cta{display:inline-flex;align-items:center;justify-content:center;margin-top:30px;border-radius:12px;padding:13px 22px;background:var(--accent-fill,#0b7a55);color:var(--on-accent,#ffffff);font-size:15px;font-weight:700;text-decoration:none}.ds-hero__cta:focus-visible{outline:2px solid var(--accent-fill,#0b7a55);outline-offset:2px}"
    },
    {
      "name": "Target Card",
      "kind": "card",
      "refersTo": "card-target",
      "description": "每日目标大数字卡，底部标注计算依据。",
      "html": "<div class=\"ds-card-target\"><div><div class=\"ds-card-target__label\">蛋白质目标 / 天</div><div class=\"ds-card-target__big\">122<span class=\"ds-card-target__unit\">g</span></div></div><div class=\"ds-card-target__basis\">1.8g × 68kg</div></div>",
      "css": ".ds-card-target{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;background:var(--surface,#ffffff);border:1px solid var(--line,#e6e6e2);border-radius:16px;padding:24px 26px;font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif;color:var(--text,#1a1a1a)}.ds-card-target__label{color:var(--muted,#6b6b6b);font-size:13px;margin-bottom:6px}.ds-card-target__big{font-size:44px;font-weight:800;line-height:1;letter-spacing:-.02em;font-variant-numeric:tabular-nums}.ds-card-target__unit{font-size:14px;color:var(--muted,#6b6b6b);font-weight:500}.ds-card-target__basis{color:var(--muted,#6b6b6b);font-size:12px;white-space:nowrap}"
    },
    {
      "name": "Food Card",
      "kind": "card",
      "refersTo": "card-food",
      "description": "食物库卡片：名称、每 100g 三大元素读数、按食材真实份量的加入按钮（鸡蛋＋1个、牛奶＋100ml、其余＋100g）。",
      "html": "<div class=\"ds-card-food\"><div class=\"ds-card-food__head\"><span class=\"ds-card-food__name\">全脂牛奶</span><span class=\"ds-card-food__unit\">每100ml</span></div><div class=\"ds-card-food__macros\"><div>蛋白<b>3.2</b></div><div>碳水<b>5</b></div><div>脂肪<b>3.6</b></div></div><button class=\"ds-card-food__add\">＋100ml</button></div>",
      "css": ".ds-card-food{display:flex;flex-direction:column;gap:10px;background:var(--surface,#ffffff);border:1px solid var(--line,#e6e6e2);border-radius:16px;padding:16px;font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif;color:var(--text,#1a1a1a);transition:border-color .12s ease,transform .12s ease}.ds-card-food:hover{border-color:var(--accent,#0f9d6e);transform:translateY(-2px)}.ds-card-food__head{display:flex;justify-content:space-between;align-items:baseline;gap:8px}.ds-card-food__name{font-weight:700;font-size:15px}.ds-card-food__unit{color:var(--muted,#6b6b6b);font-size:11px;text-align:right}.ds-card-food__macros{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;font-size:12px;color:var(--muted,#6b6b6b);font-variant-numeric:tabular-nums}.ds-card-food__macros div{background:var(--bg,#f7f7f5);border:1px solid var(--line,#e6e6e2);border-radius:8px;padding:6px 4px;text-align:center}.ds-card-food__macros b{display:block;font-size:14px;color:var(--text,#1a1a1a);font-weight:700;margin-top:1px}.ds-card-food__add{margin-top:auto;border:1px solid var(--line,#e6e6e2);background:transparent;color:var(--accent-text,#0b7a55);border-radius:10px;padding:9px 0;font-weight:700;font-size:14px;cursor:pointer;font-family:inherit;transition:background .12s ease,color .12s ease,border-color .12s ease}.ds-card-food__add:hover{background:var(--accent-fill,#0b7a55);border-color:var(--accent-fill,#0b7a55);color:var(--on-accent,#ffffff)}.ds-card-food__add:focus-visible{outline:2px solid var(--accent-fill,#0b7a55);outline-offset:2px}"
    },
    {
      "name": "Macro Chip",
      "kind": "chip",
      "refersTo": "chip-macro",
      "description": "蛋白/碳水/脂肪三读数小格，食物卡内专用。",
      "html": "<div class=\"ds-chip-macro\">蛋白<b>23</b></div>",
      "css": ".ds-chip-macro{background:var(--bg,#f7f7f5);border:1px solid var(--line,#e6e6e2);border-radius:8px;padding:6px 4px;text-align:center;color:var(--muted,#6b6b6b);font-size:12px;font-variant-numeric:tabular-nums;font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif}.ds-chip-macro b{display:block;font-size:14px;color:var(--text,#1a1a1a);font-weight:700;margin-top:1px}"
    },
    {
      "name": "Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "承载表单与列表的通用面板，如「已选食材」「采购历史」。",
      "html": "<section class=\"ds-panel\"><h3 class=\"ds-panel__title\">当日总量 vs 目标</h3><p class=\"ds-panel__body\">蛋白质 34 / 122g</p></section>",
      "css": ".ds-panel{background:var(--surface,#ffffff);border:1px solid var(--line,#e6e6e2);border-radius:12px;padding:20px;font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif;color:var(--text,#1a1a1a)}.ds-panel__title{margin:0 0 14px;font-size:15px;font-weight:700}.ds-panel__body{margin:0;color:var(--muted,#6b6b6b);font-size:14px;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Text / Number Input",
      "kind": "input",
      "refersTo": "input",
      "description": "日期、数字、文本输入与下拉，统一台面底 + 10px 圆角。",
      "html": "<label class=\"ds-field\">体重（kg）<input class=\"ds-input\" type=\"number\" value=\"68\" placeholder=\"68.0\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:6px;color:var(--muted,#6b6b6b);font-size:13px;font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif}.ds-input{background:var(--surface,#ffffff);color:var(--text,#1a1a1a);border:1px solid var(--line,#e6e6e2);border-radius:10px;padding:9px 12px;font-size:15px;font-family:inherit;font-variant-numeric:tabular-nums}.ds-input:focus{outline:2px solid var(--accent-fill,#0b7a55);outline-offset:1px;border-color:var(--accent-fill,#0b7a55)}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": null,
      "description": "60px 吸顶导航：品牌在左（链接回落地页），锚点在右，移动端隐藏锚点；落地页右侧为进入工具页的 Small Ghost 按钮。",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav__brand\" href=\"index.html\">宿舍食力计划<span class=\"ds-nav__dot\">.</span></a><span class=\"ds-nav__links\"><a class=\"ds-nav__link\" href=\"#targets\">每日目标</a><a class=\"ds-nav__link\" href=\"#foods\">食物库</a></span></nav>",
      "css": ".ds-nav{height:60px;display:flex;align-items:center;justify-content:space-between;padding:0 48px;background:var(--bg,#f7f7f5);border-bottom:1px solid var(--line,#e6e6e2);font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif}.ds-nav__brand{font-weight:800;letter-spacing:.02em;font-size:17px;color:var(--text,#1a1a1a);text-decoration:none}.ds-nav__dot{color:var(--accent,#0f9d6e)}.ds-nav__links{display:flex;gap:22px;font-size:14px}.ds-nav__link{color:var(--muted,#6b6b6b);text-decoration:none}.ds-nav__link:hover{color:var(--text,#1a1a1a)}.ds-nav__link:focus-visible{outline:2px solid var(--accent-fill,#0b7a55);outline-offset:3px;border-radius:4px}"
    },
    {
      "name": "Progress Bar",
      "kind": "custom",
      "refersTo": "progress-track",
      "description": "签名组件：当日摄入对目标的胶囊进度条，达标或超出时追加翡翠读数。",
      "html": "<div class=\"ds-progress\"><div class=\"ds-progress__line\"><span>蛋白质</span><span class=\"ds-progress__val\"><b>134</b> / 122g <span class=\"ds-progress__over\">(已达标 +12g)</span></span></div><div class=\"ds-progress__track\"><i class=\"ds-progress__fill\" style=\"transform:scaleX(1)\"></i></div></div>",
      "css": ".ds-progress{font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif;color:var(--text,#1a1a1a)}.ds-progress__line{display:flex;justify-content:space-between;font-size:13px;margin-bottom:6px;font-variant-numeric:tabular-nums}.ds-progress__val b{font-size:15px}.ds-progress__over{color:var(--accent-text,#0b7a55);font-weight:700}.ds-progress__track{height:9px;background:var(--bg,#f7f7f5);border:1px solid var(--line,#e6e6e2);border-radius:999px;overflow:hidden}.ds-progress__fill{display:block;height:100%;transform:scaleX(0);transform-origin:left;background:var(--accent,#0f9d6e);border-radius:999px;transition:transform .25s ease}"
    },
    {
      "name": "Profile Modal",
      "kind": "custom",
      "refersTo": null,
      "description": "首次进入与「修改资料」共用的浮层，采集性别/身高/体重并推算三大目标。",
      "html": "<div class=\"ds-overlay\"><div class=\"ds-modal\"><h2 class=\"ds-modal__title\">填写个人资料</h2><p class=\"ds-modal__sub\">首次使用请填写资料，系统据此自动推算你每日所需的三大元素。</p><label class=\"ds-modal__field\">体重（kg）<input class=\"ds-modal__input\" type=\"number\" placeholder=\"68.0\"></label><button class=\"ds-modal__cta\">生成我的目标</button></div></div>",
      "css": ".ds-overlay{position:relative;padding:24px;background:rgba(0,0,0,.55);border-radius:16px;display:flex;align-items:center;justify-content:center;font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif}.ds-modal{background:var(--surface,#ffffff);border:1px solid var(--line,#e6e6e2);border-radius:16px;padding:28px;max-width:420px;width:100%;color:var(--text,#1a1a1a)}.ds-modal__title{margin:0 0 8px;font-size:24px;font-weight:800}.ds-modal__sub{margin:0 0 22px;color:var(--muted,#6b6b6b);font-size:14px}.ds-modal__field{display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--muted,#6b6b6b)}.ds-modal__input{background:var(--surface,#ffffff);color:var(--text,#1a1a1a);border:1px solid var(--line,#e6e6e2);border-radius:10px;padding:9px 12px;font-size:15px;font-family:inherit;font-variant-numeric:tabular-nums}.ds-modal__input:focus{outline:2px solid var(--accent-fill,#0b7a55);outline-offset:1px}.ds-modal__cta{margin-top:26px;width:100%;border:1px solid transparent;border-radius:12px;padding:13px 22px;background:var(--accent-fill,#0b7a55);color:var(--on-accent,#ffffff);font-size:15px;font-weight:700;cursor:pointer;font-family:inherit;transition:transform .12s ease}.ds-modal__cta:active{transform:scale(.98)}"
    },
    {
      "name": "Bottom Tab Bar",
      "kind": "custom",
      "refersTo": null,
      "description": "移动端（≤760px）固定底部导航，五项：目标、食材、搭配、体重、采购。替代隐藏的顶部锚点，内联 SVG 图标，高度 56px，安全区适配。",
      "html": "<nav class=\"ds-tabbar\"><a href=\"#targets\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M9 9h6v6H9z\"/></svg>目标</a><a href=\"#foods\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5\"/></svg>食材</a><a href=\"#plan\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M9 12h6M9 16h6\"/></svg>搭配</a><a href=\"#weight\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 2v20M17 5H7\"/></svg>体重</a><a href=\"#purchases\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"9\" cy=\"21\" r=\"1\"/><circle cx=\"20\" cy=\"21\" r=\"1\"/><path d=\"M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6\"/></svg>采购</a></nav>",
